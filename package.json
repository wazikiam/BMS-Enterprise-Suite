{
  "name": "bms-enterprise-suite",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "cd packages/server && npm run dev",
    "dev:web": "cd apps/admin-web && npm run dev",
    "build": "npm run build:core && npm run build:shared && npm run build:server && npm run build:web",
    "build:core": "cd packages/core && npm run build",
    "build:shared": "cd packages/shared && npm run build",
    "build:server": "cd packages/server && npm run build",
    "build:web": "cd apps/admin-web && npm run build",
    "test": "echo '✓ Tests will be implemented in Phase 4 (Week 9-12)' && exit 0",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0"
  }
}